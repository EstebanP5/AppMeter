<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de nodo (M1): punto de estado, nombre, "Tipo · serie" y tiempo relativo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:background="@drawable/am_dot_ok" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/am_ink"
            android:textSize="14sp"
            tools:text="TR1 - Acafintex" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/am_t777"
            android:textSize="11.5sp"
            tools:text="Transformador · 140423000265" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAgo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        tools:text="hace 5 días" />
</LinearLayout>
