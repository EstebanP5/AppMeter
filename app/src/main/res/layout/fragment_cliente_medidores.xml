<?xml version="1.0" encoding="utf-8"?>
<!-- K3 · Mis medidores -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFF1D6"
            android:padding="6dp"
            android:textColor="#7A4B00"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Sin conexión · mostrando datos de 13:02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Mis medidores"
            android:textColor="@color/am_ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/am_t555"
            android:textSize="13sp"
            tools:text="Planta Huejotzingo · 4 medidores" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="Aún no hay medidores en esta localidad"
            android:textColor="@color/am_t777"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
