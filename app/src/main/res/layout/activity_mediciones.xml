<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C2333">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1C2333"
            app:titleTextColor="#FFFFFF" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== CARD DE FILTROS ===== -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#242E42"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Spinner Cliente (solo admin) -->
                        <LinearLayout
                            android:id="@+id/layoutClienteSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cliente:"
                                android:textColor="#9AA5B4"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinnerCliente"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/selector_background"
                                android:paddingHorizontal="12dp" />

                        </LinearLayout>

                        <!-- Spinner Localidad -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Localidad:"
                            android:textColor="#9AA5B4"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerLocalidad"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/selector_background"
                            android:paddingHorizontal="12dp" />

                        <!-- Botón Consultar -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConsultar"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="CONSULTAR"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#FF6B00"
                            app:cornerRadius="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== CARD: RESUMEN ENERGÍA LOCALIDAD ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEnergySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#242E42"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Resumen de Energía"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Grid 2x2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <!-- Solar -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_energy_cell"
                                android:padding="12dp"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="☀ Solar"
                                    android:textColor="#FFC107"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvSolarW"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvSolarWhDay"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Hoy: —"
                                    android:textColor="#9AA5B4"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- CFE -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_energy_cell"
                                android:padding="12dp"
                                android:layout_marginStart="4dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="⚡ CFE"
                                    android:textColor="#2196F3"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvCfeW"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvCfeWhDay"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Hoy: —"
                                    android:textColor="#9AA5B4"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Consumo Total (full width) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_energy_cell"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🏭 Consumo Total"
                                android:textColor="#FF6B00"
                                android:textSize="13sp"
                                android:gravity="center" />
                            <TextView
                                android:id="@+id/tvConsumoTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Inyección + BESS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Inyección -->
                            <LinearLayout
                                android:id="@+id/layoutInyeccion"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_energy_cell"
                                android:padding="12dp"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="🔻 Inyección"
                                    android:textColor="#4CAF50"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvInyeccionW"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- BESS -->
                            <LinearLayout
                                android:id="@+id/layoutBess"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_energy_cell"
                                android:padding="12dp"
                                android:layout_marginStart="4dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="🔋 BESS"
                                    android:textColor="#4CAF50"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvBessW"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== CARD: ESTADO DE NODOS ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardNodeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#242E42"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvNodeStatusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado de nodos"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvNodeStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== LISTA DE NODOS CON MEDICIÓN ===== -->
                <TextView
                    android:id="@+id/tvNodosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mediciones en Tiempo Real"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDeviceCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Placeholder vacío -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un cliente y localidad, luego pulsa CONSULTAR"
                    android:textColor="#9AA5B4"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="32dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
