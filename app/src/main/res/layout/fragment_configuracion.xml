<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/web_bg"
    android:padding="20dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configuración"
        android:textSize="28sp"
        android:textColor="@color/web_text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una opción"
        android:textSize="16sp"
        android:textColor="@color/web_text_secondary"
        android:layout_marginBottom="24dp" />

    <!-- Botones principales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnModoAgregar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Agregar"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_agregar_selector"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnModoModificar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Modificar"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_modificar_selector"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnModoGateways"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Gateways"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6B00"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Container para el contenido dinámico -->
    <FrameLayout
        android:id="@+id/containerModo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/container_background"
        android:padding="16dp"
        android:elevation="2dp" />

</LinearLayout>