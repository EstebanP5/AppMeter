<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración del medidor (sin sesión): header con serie + 5 pestañas. Pestaña Fasores con barra Play / Grabar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fasores_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ink"
    android:orientation="vertical">

    <!-- Header: AppMeter + chip de serie + pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="AppMeter"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/am_chip_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/dotConn"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/am_dot_live" />

                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="Conectando…"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    tools:text="140423000034" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/tab_fasores"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Fasores" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_wifi"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="WiFi" />

                <View
                    android:id="@+id/dotWifi"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/am_dot_warn"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_memoria"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Memoria" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_sub1g"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Sub-1G" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_equipo"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Equipo" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/am_err_bg"
        android:gravity="center"
        android:padding="7dp"
        android:text="Sin conexión con el medidor"
        android:textColor="@color/am_err_text"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/am_bg">

        <!-- ───────── Pestaña Fasores ───────── -->
        <ScrollView
            android:id="@+id/pageFasores"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Cableado + Sensor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/am_card12"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Cableado" />

                        <Spinner
                            android:id="@+id/spinnerCableado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/am_spinner_bg"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Sensor" />

                        <Spinner
                            android:id="@+id/spinnerSensor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/am_spinner_bg"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Banner de diagnóstico -->
                <LinearLayout
                    android:id="@+id/bannerDiag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/am_banner_idle"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:id="@+id/iconDiag"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/am_icon_idle"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDiagTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sin lecturas todavía"
                            android:textColor="@color/am_ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiagText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.1"
                            android:text="Pulsa ▶ para medir y verificar los sensores."
                            android:textColor="#333355"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/rowDiagLinks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/linkHow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Ver cómo ›"
                                android:textColor="@color/am_err_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/linkSolar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="¿Tiene paneles solares?"
                                android:textColor="@color/am_t777"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tabla eléctrica (se arma según el cableado) -->
                <LinearLayout
                    android:id="@+id/tableCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/am_card12"
                    android:clipToOutline="true"
                    android:orientation="vertical" />

                <!-- 1F·4C: tarjetas por carga -->
                <LinearLayout
                    android:id="@+id/loadsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Diagramas fasoriales U e I -->
                <LinearLayout
                    android:id="@+id/phasorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/am_phasor_box"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <de.kai_morich.simple_bluetooth_terminal.ui.medidor.PhasorView
                            android:id="@+id/phasorU"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <de.kai_morich.simple_bluetooth_terminal.ui.medidor.PhasorView
                            android:id="@+id/phasorI"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPhasorCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:textColor="#EEEEEE"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="cargas 0–3 en L1 · Load 3 ≈ 0 A" />
                </LinearLayout>

                <!-- Diagrama de conexión -->
                <LinearLayout
                    android:id="@+id/rowDiagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/am_card12"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/imgDiagramThumb"
                        android:layout_width="74dp"
                        android:layout_height="46dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Ver diagrama de conexión"
                        android:textColor="#333333"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/am_t888"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ───────── Pestaña WiFi ───────── -->
        <LinearLayout
            android:id="@+id/pageWifi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Red WiFi para el medidor"
                    android:textColor="@color/am_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvWifiNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Solo aparecen redes de 2.4 GHz. Las de 5 GHz no son compatibles."
                    android:textColor="@color/am_t666"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/wifiList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/am_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/btnWifiHidden"
                    style="@style/AmBtnOutline"
                    android:layout_marginEnd="5dp"
                    android:text="Red oculta" />

                <TextView
                    android:id="@+id/btnWifiScan"
                    style="@style/AmBtnOutline"
                    android:layout_marginStart="5dp"
                    android:text="↻ Buscar" />
            </LinearLayout>
        </LinearLayout>

        <!-- ───────── Pestaña Memoria ───────── -->
        <ScrollView
            android:id="@+id/pageMemoria"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/am_card14"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Memoria de grabación"
                    android:textColor="@color/am_ink"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Registros"
                        android:textColor="@color/am_t555"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMemUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="@color/am_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMemInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Leyendo memoria…"
                    android:textColor="@color/am_t666"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMemClose"
                        style="@style/AmBtnOutline"
                        android:layout_marginEnd="5dp"
                        android:text="Cerrar" />

                    <TextView
                        android:id="@+id/btnMemFormat"
                        style="@style/AmBtnOutline"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/am_btn_red_outline"
                        android:text="Formatear"
                        android:textColor="@color/am_err" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ───────── Pestaña Sub-1G ───────── -->
        <ScrollView
            android:id="@+id/pageSub1g"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Configurar Sub-1G"
                    android:textColor="@color/am_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvSub1gWarn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="El equipo no reporta su configuración actual. Lo que envíes la reemplaza."
                    android:textColor="#A36A00"
                    android:textSize="12.5sp" />

                <TextView
                    style="@style/AmFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="Modulación" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/am_seg_light"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/segGfsk"
                        style="@style/AmSeg"
                        android:text="GFSK 915 MHz" />

                    <TextView
                        android:id="@+id/segLora"
                        style="@style/AmSeg"
                        android:text="LoRa" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRateLabel"
                    style="@style/AmFieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="Velocidad GFSK" />

                <Spinner
                    android:id="@+id/spSub1gRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/am_spinner_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Canal" />

                        <EditText
                            android:id="@+id/etSub1gChannel"
                            style="@style/AmInput"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Salto de canales" />

                        <Spinner
                            android:id="@+id/spSub1gHop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/am_spinner_bg" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/am_line" />

                <LinearLayout
                    android:id="@+id/rowAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Avanzado"
                        android:textColor="@color/am_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAdvArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾"
                        android:textColor="@color/am_t888" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Dir. broadcast" />

                        <EditText
                            android:id="@+id/etSub1gBroadcast"
                            style="@style/AmInput"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AmFieldLabel"
                            android:text="Dir. unicast" />

                        <EditText
                            android:id="@+id/etSub1gUnicast"
                            style="@style/AmInput"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSubCancel"
                        style="@style/AmBtnOutline"
                        android:layout_marginEnd="5dp"
                        android:text="Cancelar" />

                    <TextView
                        android:id="@+id/btnSubSend"
                        style="@style/AmBtnOutline"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/am_btn_dark"
                        android:text="Enviar al equipo"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ───────── Pestaña Equipo ───────── -->
        <ScrollView
            android:id="@+id/pageEquipo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:contentDescription="ErgoMeter"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ergometer" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="ErgoMeter"
                            android:textColor="@color/am_ink"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvEqConn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Conectado por WiFi directo"
                            android:textColor="@color/am_ok"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:shrinkColumns="1"
                    android:stretchColumns="1">

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Serie" />

                        <TextView
                            android:id="@+id/tvEqSerie"
                            style="@style/AmEqValue" />

                        <TextView
                            android:id="@+id/btnCopySerie"
                            style="@style/AmEqAction"
                            android:text="Copiar" />
                    </TableRow>

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Activación" />

                        <TextView
                            android:id="@+id/tvEqAct"
                            style="@style/AmEqValue" />

                        <TextView
                            android:id="@+id/btnCopyAct"
                            style="@style/AmEqAction"
                            android:text="Copiar" />
                    </TableRow>

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Hardware" />

                        <TextView
                            android:id="@+id/tvEqHw"
                            style="@style/AmEqValue" />

                        <View />
                    </TableRow>

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Firmware" />

                        <TextView
                            android:id="@+id/tvEqFw"
                            style="@style/AmEqValue" />

                        <View />
                    </TableRow>

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Fabricación" />

                        <TextView
                            android:id="@+id/tvEqFab"
                            style="@style/AmEqValue" />

                        <View />
                    </TableRow>

                    <TableRow style="@style/AmEqRow">

                        <TextView
                            style="@style/AmEqLabel"
                            android:text="Hora equipo" />

                        <TextView
                            android:id="@+id/tvEqHora"
                            style="@style/AmEqValue" />

                        <TextView
                            android:id="@+id/tvEqHoraState"
                            style="@style/AmEqAction"
                            android:textColor="@color/am_ok" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/btnShare"
                    style="@style/AmBtnOutline"
                    android:layout_width="match_parent"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/am_btn_dark"
                    android:text="Compartir datos del equipo"
                    android:textColor="@color/white" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ───────── Barra inferior (sólo pestaña Fasores) ───────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/am_line2" />

        <LinearLayout
            android:id="@+id/bottomBarInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Conectando…"
                    android:textColor="@color/am_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:textColor="@color/am_t666"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/am_play_circle"
                android:clickable="true"
                android:contentDescription="Medir en vivo"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iconPlay"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_am_play" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/btnRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/am_rec_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <View
                    android:id="@+id/dotRec"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/am_dot_white" />

                <TextView
                    android:id="@+id/tvRecText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Grabar"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
