<?xml version="1.0" encoding="utf-8"?>
<!-- K4 · Detalle de un medidor -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="←"
                android:textColor="@color/am_ink"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/am_ink"
                    android:textSize="18sp"
                    tools:text="Acometida CFE" />

                <TextView
                    android:id="@+id/tvSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/am_t666"
                    android:textSize="12sp"
                    tools:text="Entrada general · actualizado hace 1 min" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ahora (tarjeta oscura) -->
        <LinearLayout
            android:id="@+id/cardNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/am_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ahora"
                    android:textColor="@color/am_t888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/am_badge_ok"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="Funcionando"
                    android:textColor="@color/am_ok_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="--"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold"
                tools:text="400.7 kW" />

            <TextView
                android:id="@+id/tvShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/am_t888"
                android:textSize="12.5sp"
                tools:text="68% del consumo de la planta" />

            <!-- Hoy / Semana / Mes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/am_tab_dark_bg"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabDay"
                    style="@style/AmDarkTab"
                    android:text="Hoy" />

                <TextView
                    android:id="@+id/tabWeek"
                    style="@style/AmDarkTab"
                    android:text="Semana" />

                <TextView
                    android:id="@+id/tabMonth"
                    style="@style/AmDarkTab"
                    android:text="Mes" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp">

                <de.kai_morich.simple_bluetooth_terminal.ui.charts.DarkChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <de.kai_morich.simple_bluetooth_terminal.ui.charts.StackedBarsView
                    android:id="@+id/bars"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLegA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/am_cfe_on_dark"
                    android:textSize="11sp"
                    tools:text="● Hoy" />

                <TextView
                    android:id="@+id/tvLegB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/am_t888"
                    android:textSize="11sp"
                    tools:text="┄ Ayer" />
            </LinearLayout>
        </LinearLayout>

        <!-- Energía hoy / Pico / Promedio -->
        <LinearLayout
            android:id="@+id/rowStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/AmStatCard"
                android:layout_marginEnd="4dp">

                <TextView
                    style="@style/AmStatLabel"
                    android:text="Energía hoy" />

                <TextView
                    android:id="@+id/tvToday"
                    style="@style/AmStatValue"
                    android:text="--" />

                <TextView
                    style="@style/AmStatUnit"
                    android:text="kWh" />

                <TextView
                    android:id="@+id/tvDelta"
                    style="@style/AmStatExtra"
                    android:text=" " />
            </LinearLayout>

            <LinearLayout
                style="@style/AmStatCard"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    style="@style/AmStatLabel"
                    android:text="Pico hoy" />

                <TextView
                    android:id="@+id/tvPeak"
                    style="@style/AmStatValue"
                    android:text="--" />

                <TextView
                    style="@style/AmStatUnit"
                    android:text="kW" />

                <TextView
                    android:id="@+id/tvPeakAt"
                    style="@style/AmStatUnit"
                    android:text=" " />
            </LinearLayout>

            <LinearLayout
                style="@style/AmStatCard"
                android:layout_marginStart="4dp">

                <TextView
                    style="@style/AmStatLabel"
                    android:text="Promedio" />

                <TextView
                    android:id="@+id/tvAvg"
                    style="@style/AmStatValue"
                    android:text="--" />

                <TextView
                    style="@style/AmStatUnit"
                    android:text="kW" />

                <TextView
                    style="@style/AmStatUnit"
                    android:text="desde 00:00" />
            </LinearLayout>
        </LinearLayout>

        <!-- Calidad de energía -->
        <LinearLayout
            android:id="@+id/cardQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/am_card14"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Calidad de energía"
                    android:textColor="@color/am_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/am_badge_ok"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="—"
                    android:textColor="@color/am_ok_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Corriente por fase"
                android:textColor="@color/am_t666"
                android:textSize="12sp" />

            <LinearLayout style="@style/AmCurRow">

                <TextView
                    style="@style/AmCurLabel"
                    android:text="L1"
                    android:textColor="#111111"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/trk1"
                    style="@style/AmCurTrack">

                    <View
                        android:id="@+id/fill1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/am_phase_fill1" />

                    <View
                        android:id="@+id/rest1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvA1"
                    style="@style/AmCurValue" />
            </LinearLayout>

            <LinearLayout style="@style/AmCurRow">

                <TextView
                    style="@style/AmCurLabel"
                    android:text="L2"
                    android:textColor="#E00000"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/trk2"
                    style="@style/AmCurTrack">

                    <View
                        android:id="@+id/fill2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/am_phase_fill2" />

                    <View
                        android:id="@+id/rest2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvA2"
                    style="@style/AmCurValue" />
            </LinearLayout>

            <LinearLayout style="@style/AmCurRow">

                <TextView
                    style="@style/AmCurLabel"
                    android:text="L3"
                    android:textColor="#1E7BFF"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/trk3"
                    style="@style/AmCurTrack">

                    <View
                        android:id="@+id/fill3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/am_phase_fill3" />

                    <View
                        android:id="@+id/rest3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvA3"
                    style="@style/AmCurValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/AmMiniMetric"
                    android:layout_marginEnd="4dp">

                    <TextView
                        style="@style/AmStatLabel"
                        android:text="Voltaje" />

                    <TextView
                        android:id="@+id/tvVolt"
                        style="@style/AmMiniValue" />

                    <TextView
                        android:id="@+id/tvVoltNote"
                        style="@style/AmStatUnit" />
                </LinearLayout>

                <LinearLayout
                    style="@style/AmMiniMetric"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        style="@style/AmStatLabel"
                        android:text="Desbalance" />

                    <TextView
                        android:id="@+id/tvImb"
                        style="@style/AmMiniValue" />

                    <TextView
                        android:id="@+id/tvImbNote"
                        style="@style/AmStatUnit" />
                </LinearLayout>

                <LinearLayout
                    style="@style/AmMiniMetric"
                    android:layout_marginStart="4dp">

                    <TextView
                        style="@style/AmStatLabel"
                        android:text="F. potencia" />

                    <TextView
                        android:id="@+id/tvPf"
                        style="@style/AmMiniValue" />

                    <TextView
                        android:id="@+id/tvPfNote"
                        style="@style/AmStatUnit" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/rowTech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/am_card14"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="14dp"
            android:text="Datos técnicos ›"
            android:textColor="@color/am_accent"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
