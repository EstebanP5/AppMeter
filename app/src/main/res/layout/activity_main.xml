<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor raíz: cada pantalla dibuja su propio header oscuro; abajo, barra fija de 3 destinos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ink"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/am_bg" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/am_line2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/nav_inicio"
                style="@style/AmNavItem">

                <ImageView
                    style="@style/AmNavIcon"
                    android:src="@drawable/ic_home" />

                <TextView
                    style="@style/AmNavLabel"
                    android:text="Inicio" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_mediciones"
                style="@style/AmNavItem">

                <ImageView
                    style="@style/AmNavIcon"
                    android:src="@drawable/ic_analytics" />

                <TextView
                    style="@style/AmNavLabel"
                    android:text="Mediciones" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_configurar"
                style="@style/AmNavItem">

                <ImageView
                    style="@style/AmNavIcon"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/AmNavLabel"
                    android:text="Configurar" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
