<?xml version="1.0" encoding="utf-8"?>
<!-- A3-A5 · Nodo: encabezado oscuro con pestañas Ahora · Potencia día · Energía día; cada una es un fragmento -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nodo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/am_ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNodeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    tools:text="Molino B" />

                <TextView
                    android:id="@+id/tvNodeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● consultando…"
                    android:textColor="@color/am_tAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNodeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/am_chip_dark"
                android:fontFamily="monospace"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                tools:text="LOAD · 140423000205" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/tabAhora"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Ahora" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabPotencia"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Potencia día" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabEnergia"
                style="@style/AmTab">

                <TextView
                    style="@style/AmTabText"
                    android:text="Energía día" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nodo_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/am_bg" />
</LinearLayout>
