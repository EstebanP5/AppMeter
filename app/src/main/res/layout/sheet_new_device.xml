<?xml version="1.0" encoding="utf-8"?>
<!-- C3 · Nuevo dispositivo: tipo, nombre, descripción, serie y carga en un solo paso -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/am_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/am_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Nuevo dispositivo"
        android:textColor="@color/am_ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvCrumbs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/am_t666"
        android:textSize="12.5sp"
        tools:text="Acafintex › Acabados Finos Textiles › CFE y PV" />

    <TextView
        style="@style/AmFieldLabel"
        android:layout_marginTop="12dp"
        android:text="Tipo de nodo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipType0"
            style="@style/AmTypeChip"
            android:text="Transformador" />

        <TextView
            android:id="@+id/chipType1"
            style="@style/AmTypeChip"
            android:layout_marginStart="6dp"
            android:text="Solar" />

        <TextView
            android:id="@+id/chipType2"
            style="@style/AmTypeChip"
            android:layout_marginStart="6dp"
            android:text="CFE" />

        <TextView
            android:id="@+id/chipType3"
            style="@style/AmTypeChip"
            android:layout_marginStart="6dp"
            android:text="Batería" />
    </LinearLayout>

    <TextView
        style="@style/AmFieldLabel"
        android:layout_marginTop="12dp"
        android:text="Nombre" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/am_input"
        android:inputType="textCapSentences"
        android:maxLength="80"
        android:padding="10dp"
        android:textColor="@color/am_ink"
        android:textSize="14sp" />

    <TextView
        style="@style/AmFieldLabel"
        android:layout_marginTop="12dp"
        android:text="Descripción · opcional" />

    <EditText
        android:id="@+id/etDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/am_input"
        android:hint="Ej. tablero principal nave 2"
        android:inputType="textCapSentences"
        android:padding="10dp"
        android:textColor="@color/am_ink"
        android:textColorHint="#AAAAAA"
        android:textSize="14sp" />

    <!-- Medidor: se oculta para CFE virtual -->
    <LinearLayout
        android:id="@+id/groupMeter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/am_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Medidor"
            android:textColor="@color/am_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            style="@style/AmFieldLabel"
            android:layout_marginTop="8dp"
            android:text="Número de serie" />

        <EditText
            android:id="@+id/etSerie"
            style="@style/AmInput"
            android:layout_marginTop="4dp"
            android:inputType="textCapCharacters|textNoSuggestions" />

        <TextView
            android:id="@+id/tvSerieState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            style="@style/AmFieldLabel"
            android:layout_marginTop="12dp"
            android:text="Carga (Load)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/load0"
                style="@style/AmLoadBox"
                android:text="0" />

            <TextView
                android:id="@+id/load1"
                style="@style/AmLoadBox"
                android:layout_marginStart="6dp"
                android:text="1" />

            <TextView
                android:id="@+id/load2"
                style="@style/AmLoadBox"
                android:layout_marginStart="6dp"
                android:text="2" />

            <TextView
                android:id="@+id/load3"
                style="@style/AmLoadBox"
                android:layout_marginStart="6dp"
                android:text="3" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/AmBtnOutline"
            android:layout_marginEnd="5dp"
            android:text="Cancelar" />

        <TextView
            android:id="@+id/btnSave"
            style="@style/AmBtnOutline"
            android:layout_marginStart="5dp"
            android:layout_weight="1.4"
            android:background="@drawable/am_btn_accent"
            android:text="Guardar y vincular"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
